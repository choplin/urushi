---
import ConceptLayout from '../../layouts/ConceptLayout.astro';
---

<ConceptLayout concept="kuro" title="Urushi — Design concepts">
  <main class="concept-index">
    <header class="index-header">
      <a class="concept-brand" href="/">urushi</a>
      <p>Homepage explorations / 0.1.0</p>
    </header>
    <section class="index-intro">
      <p class="concept-kicker">Three directions</p>
      <h1>Choose the character,<br />not just the color.</h1>
      <p>Each proposal changes hierarchy, rhythm, and the way Urushi explains its shared presentation model.</p>
    </section>
    <section class="concept-list" aria-label="Design proposals">
      <a class="concept-tile tile-kuro" href="/designs/kuro/">
        <span>01 / 黒呂色</span>
        <strong>Precision in black.</strong>
        <small>Dense · architectural · product-led</small>
      </a>
      <a class="concept-tile tile-shiro" href="/designs/shiro/">
        <span>02 / 白漆</span>
        <strong>Documentation as editorial.</strong>
        <small>Light · spacious · reading-led</small>
      </a>
      <a class="concept-tile tile-raden" href="/designs/raden/">
        <span>03 / 螺鈿</span>
        <strong>A spectrum for every surface.</strong>
        <small>Technical · luminous · brand-led</small>
      </a>
    </section>
  </main>
</ConceptLayout>
