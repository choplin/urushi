<figure class="box-model" role="group" aria-labelledby="box-model-caption">
  <figcaption id="box-model-caption">Box-model order</figcaption>
  <p>
    Each rectangle contains the next one. Space is measured from the outside
    inward: margin, border, padding, then the child View.
  </p>

  <div
    class="box-model__diagram"
    role="img"
    aria-label="Margin contains the border, the border contains padding, and padding contains the child View."
  >
    <div class="box-model__layer box-model__margin">
      <span class="box-model__label">
        <strong>Margin</strong>
        <small>outside spacing</small>
      </span>
      <div class="box-model__layer box-model__border">
        <span class="box-model__label">
          <strong>Border</strong>
          <small>edge glyphs</small>
        </span>
        <div class="box-model__layer box-model__padding">
          <span class="box-model__label">
            <strong>Padding</strong>
            <small>inside spacing</small>
          </span>
          <div class="box-model__content">
            <strong>Content</strong>
            <span>child View</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>

