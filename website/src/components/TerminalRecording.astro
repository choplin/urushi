---
interface Props {
  src: string;
  poster: string;
  label: string;
  caption: string;
}

const { src, poster, label, caption } = Astro.props;
---

<figure class="terminal-recording">
  <video
    controls
    loop
    muted
    playsinline
    preload="metadata"
    poster={poster}
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
    <a href={src}>Download the terminal recording</a>.
  </video>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .terminal-recording {
    margin: 1.25rem 0 1.75rem;
  }

  .terminal-recording video {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: #1e1e2e;
    box-shadow: 0 0.6rem 1.8rem color-mix(in srgb, var(--sl-color-black) 24%, transparent);
  }

  .terminal-recording figcaption {
    margin-top: 0.55rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }
</style>
