---
import Default from '@astrojs/starlight/components/Header.astro';
---

<div class="docs-site-header">
  <div class="docs-site-banner">
    <a href="/" aria-label="Urushi home">
      <img src="/brand/urushi-icon.png" width="36" height="36" alt="" />
      <span>Urushi</span>
    </a>
    <span>Documentation</span>
  </div>
  <Default />
</div>

<style>
  .docs-site-header {
    height: 100%;
  }

  .docs-site-banner {
    align-items: center;
    background: #111110;
    border-bottom: 1px solid rgba(183, 154, 96, 0.22);
    color: #f4f2ed;
    display: flex;
    font: 600 0.75rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    gap: 0.8rem;
    justify-content: center;
    letter-spacing: 0.08em;
    height: var(--docs-site-banner-height);
    text-transform: uppercase;
  }

  .docs-site-banner a {
    align-items: center;
    color: #dc5947;
    display: inline-flex;
    font-weight: 800;
    gap: 0.15rem;
    text-decoration: none;
  }

  .docs-site-banner img {
    display: block;
    height: 2rem;
    width: 2rem;
  }

  .docs-site-banner a span {
    color: #dc5947;
    opacity: 1;
  }

  .docs-site-banner span {
    opacity: 0.72;
  }
</style>
