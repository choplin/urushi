<figure class="coordinate-diagram" role="group" aria-label="Canvas coordinate system">
  <figcaption>Canvas coordinate system</figcaption>
  <p>
    The origin is the top-left cell. Positive x moves right and positive y moves down;
    the highlighted cell is at (3, 2).
  </p>
  <svg viewBox="0 0 640 300" role="img" aria-labelledby="canvas-coordinate-title canvas-coordinate-desc">
    <title id="canvas-coordinate-title">Canvas coordinates increase rightward and downward</title>
    <desc id="canvas-coordinate-desc">A cell grid begins at zero comma zero in the top left. Arrows show positive x to the right and positive y downward. Cell three comma two is highlighted.</desc>
    <defs>
      <marker id="canvas-coordinate-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" class="arrow-head" />
      </marker>
      <pattern id="canvas-coordinate-grid" width="72" height="56" patternUnits="userSpaceOnUse">
        <path d="M72 0 H0 V56" class="grid-line" />
      </pattern>
    </defs>

    <rect x="112" y="54" width="360" height="168" rx="8" class="grid-background" />
    <rect x="112" y="54" width="360" height="168" rx="8" fill="url(#canvas-coordinate-grid)" />
    <rect x="328" y="166" width="72" height="56" class="selected-cell" />

    <circle cx="112" cy="54" r="6" class="origin" />
    <text x="96" y="38" class="coordinate-label">(0, 0)</text>
    <text x="364" y="198" class="selected-label">(3, 2)</text>

    <path d="M112 242 H500" class="axis" marker-end="url(#canvas-coordinate-arrow)" />
    <text x="514" y="248" class="axis-label">+x</text>
    <path d="M82 54 V246" class="axis" marker-end="url(#canvas-coordinate-arrow)" />
    <text x="62" y="270" class="axis-label">+y</text>
  </svg>
</figure>
