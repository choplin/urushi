---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found — Urushi"
  description="The requested Urushi page does not exist."
>
  <section class="not-found section-shell">
    <p class="section-index">404 / NOT FOUND</p>
    <h1>This surface<br /><em>doesn’t exist.</em></h1>
    <p>The requested page may have moved, or the address may be incomplete.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/">Return home <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="/docs/">Open the documentation</a>
    </div>
  </section>
</SiteLayout>
